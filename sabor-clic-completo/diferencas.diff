-       COUNT(*)                                   AS qtd_pedidos,
-       SUM(p.valor_total)                         AS faturamento,
-       CAST(AVG(p.valor_total) AS DECIMAL(10,2))  AS ticket_medio
-FROM Pedido AS p
-GROUP BY CAST(p.data_hora_pedido AS DATE)
-ORDER BY dia DESC;
-
-/* ---- A2. Pratos mais vendidos (unidades e receita) ---- */
