-       SUM(ip.quantidade * ip.preco_unitario)                AS receita,
-       CAST(100.0 * SUM(ip.quantidade * ip.preco_unitario)
-            / SUM(SUM(ip.quantidade * ip.preco_unitario)) OVER ()
-            AS DECIMAL(5,2))                                 AS percentual
-FROM Item_Pedido AS ip
-JOIN Prato AS pr ON pr.id_prato = ip.id_prato
-GROUP BY ISNULL(pr.categoria, N'Sem categoria')
-ORDER BY receita DESC;
-
-/* ---- A4. Pedidos por status, com o pedido mais antigo de cada fila ---- */
-SELECT p.status,
-       COUNT(*)                  AS qtd_pedidos,
-       MIN(p.data_hora_pedido)   AS pedido_mais_antigo
-FROM Pedido AS p
-GROUP BY p.status
