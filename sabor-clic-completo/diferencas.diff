-             WHEN N'Aguardando'          THEN 1
-             WHEN N'Iniciando Preparo'   THEN 2
-             WHEN N'Em Preparo'          THEN 3
-             WHEN N'Pronto para Entrega' THEN 4
-         END;
-
-/* ---- A5. Fila da cozinha (KDS): pedidos ainda não finalizados ---- */
-SELECT p.id_pedido,
-       p.status,
-       p.data_hora_pedido,
-       DATEDIFF(MINUTE, p.data_hora_pedido, SYSDATETIME())             AS minutos_na_fila,
-       uc.nome                                                         AS cliente,
-       ISNULL(uz.nome, N'(sem cozinheiro)')                            AS cozinheiro,
-       STRING_AGG(CONCAT(ip.quantidade, N'x ', pr.nome), N', ')        AS itens,
-       SUM(ip.quantidade * ISNULL(ip.tempo_estimado_preparo, 0))       AS minutos_estimados_preparo
-FROM Pedido AS p
-JOIN Usuario AS uc          ON uc.id_usuario = p.id_usuario_cliente
-LEFT JOIN Usuario AS uz     ON uz.id_usuario = p.id_usuario_cozinheiro
-JOIN Item_Pedido AS ip      ON ip.id_pedido  = p.id_pedido
